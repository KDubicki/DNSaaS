# DNSaaS Configuration Example
# Copy this file to .env and customize for your environment

# Network Configuration
# DNS_NETWORK_SUBNET=172.20.0.0/16

# Upstream DNS Servers (comma-separated)
# UPSTREAM_DNS_1=8.8.8.8
# UPSTREAM_DNS_2=8.8.4.4
# UPSTREAM_DNS_3=1.1.1.1

# Local Domain Name
LOCAL_DOMAIN=homelab.local

# DNS Server IP (set this to your server's IP)
DNS_SERVER_IP=192.168.1.10
